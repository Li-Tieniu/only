# Documentation template only. Spring Boot does not automatically load this file.
# Export variables in each app/console process; fill secrets locally, never commit them.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/game?allowPublicKeyRetrieval=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&useAffectedRows=true
DB_USERNAME=only_app
DB_PASSWORD=
JWT_SECRET=
CACHE_TYPE=none
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=
REDIS_PASSWORD=
# DB_PASSWORD and JWT_SECRET must be supplied before startup.
# Generate a random JWT_SECRET (at least 32 bytes); app and console must share it.
# Configure TLS and least-privilege accounts separately for non-local deployment.
